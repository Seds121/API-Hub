# Rendered by the official nginx image (envsubst) from APP_HOST / API_HOST at container start.
# TLS cert: Let's Encrypt cert named "zeze" covering both hosts (see infra/scripts/bootstrap-vps.sh).
server_tokens off;
client_max_body_size 2m;
proxy_read_timeout 75s;
limit_req_zone $binary_remote_addr zone=perip:20m rate=50r/s;
log_format zz '$remote_addr "$request_method $uri" $status $body_bytes_sent $request_time rid=$sent_http_x_request_id';
access_log /var/log/nginx/access.log zz;   # no query strings, no auth headers
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

upstream zz_web { server web:3000; keepalive 32; }
upstream zz_api { server api:4000; keepalive 64; }

server {
  listen 80 default_server;
  server_name _;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

# Customer API traffic: only the gateway and liveness are exposed on the API host.
server {
  listen 443 ssl;
  http2 on;
  server_name ${API_HOST};
  ssl_certificate /etc/letsencrypt/live/zeze/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/zeze/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  limit_req zone=perip burst=200 nodelay;
  location /v1/ {
    proxy_pass http://zz_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
  location = /api/health/live {
    proxy_pass http://zz_api;
    proxy_set_header X-Forwarded-Proto https;
  }
  location / { return 404; }
}

# Web application (site, dashboard, admin) + management API under /api.
server {
  listen 443 ssl;
  http2 on;
  server_name ${APP_HOST};
  ssl_certificate /etc/letsencrypt/live/zeze/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/zeze/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  limit_req zone=perip burst=200 nodelay;
  location /api/ {
    proxy_pass http://zz_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
  location /v1/ {
    proxy_pass http://zz_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
  location / {
    proxy_pass http://zz_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}
