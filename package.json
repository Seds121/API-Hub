{
  "name": "zeze-api-marketplace",
  "private": true,
  "version": "0.1.0",
  "description": "Ze-Ze Technologies — API Marketplace & Reseller Platform",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "pnpm --filter @zeze/api dev",
    "dev:web": "pnpm --filter @zeze/web dev",
    "db:migrate": "pnpm --filter @zeze/api prisma:migrate",
    "db:seed": "pnpm --filter @zeze/api prisma:seed"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  }
}
