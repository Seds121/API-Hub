# ─────────────────────────────────────────────────────────────
# Ze-Ze Technologies — API Marketplace. Copy to .env and fill in.
# NEVER commit .env. Values below are placeholders, not secrets.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
# Live demo/staging: keeps production hardening but enables mock suppliers, demo payments and demo seed data.
DEMO_MODE=false
COMPANY_NAME="Ze-Ze Technologies"
NEXT_PUBLIC_COMPANY_NAME="Ze-Ze Technologies"

# Public URLs
APP_URL=http://localhost:3000             # web app (customer/admin/public site)
API_PUBLIC_URL=http://localhost:4000      # gateway base shown in docs (prod: https://api.<your-domain>)
NEXT_PUBLIC_API_PUBLIC_URL=http://localhost:4000   # dev fallback only; the web app reads API_PUBLIC_URL at runtime
API_INTERNAL_URL=http://localhost:4000    # used by Next.js server-side rewrites
PORT=4000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1

# Data stores
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zeze?schema=public&connection_limit=20"
REDIS_URL=redis://localhost:6379

# Secrets — generate each with: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME
JWT_SECRET=CHANGE_ME
API_KEY_HMAC_SECRET=CHANGE_ME
# 32-byte key, base64. Rotating requires re-encryption (see docs/SECURITY.md).
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# Sessions
SESSION_TTL_HOURS=72
COOKIE_DOMAIN=

# Gateway
GATEWAY_MAX_BODY_BYTES=1048576
GATEWAY_RESERVATION_TTL_SECONDS=120
# Allow upstream calls to private/loopback addresses (ONLY for local mock upstream in dev/test).
GATEWAY_ALLOW_PRIVATE_UPSTREAMS=false
DATA_RETENTION_DAYS=90

# Payments — REQUIRE REAL CREDENTIALS for live use
PAYMENT_PROVIDERS=mock,manual_bank   # comma list: stripe,paypal,manual_bank,mock (mock is ignored in production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
BANK_TRANSFER_INSTRUCTIONS="Bank: <your bank> | IBAN: <your IBAN> | Reference: your invoice number"

# Email (optional; logs to console when unset)
SMTP_URL=
EMAIL_FROM="Ze-Ze Technologies <no-reply@example.com>"

# Seed / demo
SEED_ADMIN_EMAIL=admin@zeze.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026
MOCK_UPSTREAM_URL=http://127.0.0.1:4010
# Optional, development / DEMO_MODE seed convenience only: seeds a REAL Brave Search provider and the
# published brave-web-search API. In production, add the Brave key in Admin → API Providers → Credentials.
BRAVE_API_KEY=

# Docker Compose (infra/docker-compose.yml) — generated by infra/scripts/bootstrap-vps.sh on the VPS
GHCR_IMAGE_PREFIX=ghcr.io/seds121/api-hub
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
APP_HOST=app.example.com
API_HOST=api.example.com
TLS_CERT_DIR=./nginx/certs
